# ==========================================
# SecureLens (WMSA) FastAPI Environment Config
# Copy this file to backend/.env and populate
# ==========================================

# --- AI API Keys (Required for Copilot & AI Code Review) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Database Config ---
# For AWS RDS PostgreSQL: postgresql://<user>:<password>@<rds-endpoint>:5432/postgres
# Leave unset or empty to use local SQLite (wmsa.db)
DATABASE_URL=

# --- CORS Settings ---
# Comma-separated allowed frontend origins or * for all
CORS_ALLOWED_ORIGINS=*

# --- Optional Model Overrides ---
# WMSA_GROQ_MODEL=openai/gpt-oss-120b
# WMSA_GEMINI_MODEL=gemini-3.8-flash
